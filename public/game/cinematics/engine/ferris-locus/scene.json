 "lines": [
  {
   "n": 1,
   "start": 16.0,
   "duration": 2.0,
   "speaker": "diarder",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierMarianna01",
    "wave": "CS_FR_CarrierMarianna01",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/01.ogg",
    "mp3": "voice/01.mp3",
    "duration": 2.006
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Помилуй нас Свет...",
    "en": "Oh Light, have mercy...",
    "fr": "Ô Lumière, ayez pitié..."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastStart_Sub1.(ClientData).xdb"
  },
  {
   "n": 2,
   "start": 22.0,
   "duration": 4.0,
   "speaker": "rysina",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierRysina01",
    "wave": "CS_FR_CarrierRysina01",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/02.ogg",
    "mp3": "voice/02.mp3",
    "duration": 6.226
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Боюсь, Свет нам тут не поможет... Что это такое?",
    "en": "I'm afraid, the Light won't help us here... What is this?",
    "fr": "J'ai peur que la Lumière ne puisse nous aider ici... Qu'est-ce que c'est ?"
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastStart_Sub2.(ClientData).xdb"
  },
  {
   "n": 3,
   "start": 27.0,
   "duration": 2.0,
   "speaker": "colossus",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierVayatel01",
    "wave": "CS_FR_CarrierVayatel01",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/03.ogg",
    "mp3": "voice/03.mp3",
    "duration": 3.256
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Это - Локус.",
    "en": "This is Locus.",
    "fr": "C'est le Locus."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastStart_Sub3.(ClientData).xdb"
  },
  {
   "n": 4,
   "start": 30.0,
   "duration": 5.0,
   "speaker": "colossus",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierVayatel02",
    "wave": "CS_FR_CarrierVayatel02",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/04.ogg",
    "mp3": "voice/04.mp3",
    "duration": 10.507
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Здесь материя обретает форму и становится частью единого целого.",
    "en": "Here matter acquires shape and becomes a part of the whole."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastStart_Sub4.(ClientData).xdb"
  },
  {
   "n": 5,
   "start": 38.0,
   "duration": 4.0,
   "speaker": "colossus",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierVayatel03",
    "wave": "CS_FR_CarrierVayatel03",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/05.ogg",
    "mp3": "voice/05.mp3",
    "duration": 8.257
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Совершенство есть порядок. Порядок есть целостность.",
    "en": "Perfectness is order. Order is wholeness."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastStart_Sub5.(ClientData).xdb"
  },
  {
   "n": 6,
   "start": 46.0,
   "duration": 4.0,
   "speaker": "colossus",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierVayatel04",
    "wave": "CS_FR_CarrierVayatel04",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/06.ogg",
    "mp3": "voice/06.mp3",
    "duration": 7.506
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Нарушив целостность Локуса, вы нарушите гармонию Порядка...",
    "en": "If you disrupt Locus' wholeness, you will disrupt the harmony of the world..."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastStart_Sub6.(ClientData).xdb"
  },
  {
   "n": 7,
   "start": 55.0,
   "duration": 4.0,
   "speaker": "rysina",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierRysina02",
    "wave": "CS_FR_CarrierRysina02",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/07.ogg",
    "mp3": "voice/07.mp3",
    "duration": 4.084
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Не время для философии! Мы должны остановить его!",
    "en": "No time for philosophy! We have to stop him!",
    "fr": "Nous n'avons pas le temps de philosopher ! Nous devons l'arrêter !"
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastStart_Sub7.(ClientData).xdb"
  },
  {
   "n": 8,
   "start": 61.0,
   "duration": 6.0,
   "speaker": "colossus",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierVayatel05",
    "wave": "CS_FR_CarrierVayatel05",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/08.ogg",
    "mp3": "voice/08.mp3",
    "duration": 10.257
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Вы? Это не имеет смысла. Вам не нарушить столь совершенной структуры.",
    "en": "You? This is pointless. You cannot break such a perfect structure."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastStart_Sub8.(ClientData).xdb"
  },
  {
   "n": 9,
   "start": 68.0,
   "duration": 4.0,
   "speaker": "colossus",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierVayatel06",
    "wave": "CS_FR_CarrierVayatel06",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/09.ogg",
    "mp3": "voice/09.mp3",
    "duration": 13.507
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Если только... Уничтожьте материю! Разрушьте Низших! И тогда бытие Локуса потеряет смысл.",
    "en": "Unless... You destroy matter! Destroy the Inferiors! Then the existence of Locus will lose its meaning."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastStart_Sub9.(ClientData).xdb"
  },
  {
   "n": 10,
   "start": 77.0,
   "duration": 6.0,
   "speaker": "colossus",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierVayatel07",
    "wave": "CS_FR_CarrierVayatel07",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/10.ogg",
    "mp3": "voice/10.mp3",
    "duration": 9.007
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Мы... Я... Целое зовёт меня. Не рассчитывайте на мою помощь.",
    "en": "We... I... The whole is calling for me. Don't count on my help.",
    "fr": "Nous... Je... Le tout m'appelle. Ne comptez pas sur mon aide."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastStart_Sub10.(ClientData).xdb"
  },
  {
   "n": 11,
   "start": 86.0,
   "duration": 3.0,
   "speaker": "rysina",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierRysina03",
    "wave": "CS_FR_CarrierRysina03",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/11.ogg",
    "mp3": "voice/11.mp3",
    "duration": 1.608
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Да уж как-нибудь обойдёмся...",
    "en": "We'll get along somehow...",
    "fr": "Nous nous sommes d'une certaine façon entendus..."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastStart_Sub11.(ClientData).xdb"
  },
  {
   "n": 12,
   "start": 89.0,
   "duration": 4.0,
   "speaker": "bosslast",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierArch01",
    "wave": "CS_FR_CarrierArch01",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/12.ogg",
    "mp3": "voice/12.mp3",
    "duration": 4.368
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Порождения хаоса... Зачем вы пришли в мой мир? Аз есмь архитектор! Аз есмь Порядок!",
    "en": "Children of chaos... Why did you come to my world? I am the Architect! I am the Order!"
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastStart_Sub12.(ClientData).xdb"
  },
  {
   "n": 13,
   "start": 101.0,
   "duration": 2.0,
   "speaker": "bosslast",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierArch02",
    "wave": "CS_FR_CarrierArch02",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/13.ogg",
    "mp3": "voice/13.mp3",
    "duration": 5.425
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Вам предстоит возвыситься. Стать совершенными. Целостными... Как и нашей отколовшейся частице!",
    "en": "You are going to ascend. Become perfect. Become whole... as well as our loose shard!",
    "fr": "Vous allez connaître l'Ascension. Devenir parfaits. Faire partie du tout... comme notre éclat perdu !"
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastStart_Sub13.(ClientData).xdb"
  }
 ],
