 "lines": [
  {
   "n": 1,
   "start": 0.0,
   "duration": 17.0,
   "speaker": null,
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_SwarmArch01",
    "wave": "CS_FR_SwarmArch01",
    "bank": "SFX/Voice/Voice_CS_FR602_02_cs_rus.bsb",
    "ogg": "voice/01.ogg",
    "mp3": "voice/01.mp3",
    "duration": 5.003
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Очень хорошо... Продолжайте ваше вторжение.",
    "en": "Very well... Continue your invasion.",
    "fr": "Très bien... Continuez votre invasion."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/Swarm_Sub_1.(ClientData).xdb"
  },
  {
   "n": 2,
   "start": 13.0,
   "duration": 17.0,
   "speaker": null,
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_SwarmArch02",
    "wave": "CS_FR_SwarmArch02",
    "bank": "SFX/Voice/Voice_CS_FR602_02_cs_rus.bsb",
    "ogg": "voice/02.ogg",
    "mp3": "voice/02.mp3",
    "duration": 5.003
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Мы рады продемонстрировать вам силу порядка. Смотрите. Анализируйте. Готовьтесь.",
    "en": "We are happy to demonstrate you the power of order. See. Analyze. Prepare.",
    "fr": "Nous sommes heureux de vous démontrer la force de l'ordre. Voir. Analyser. Préparez."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/Swarm_Sub_2.(ClientData).xdb"
  },
  {
   "n": 3,
   "start": 31.0,
   "duration": 10.0,
   "speaker": "diarder",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_SwarmMarianna05",
    "wave": "CS_FR_SwarmMarianna05",
    "bank": "SFX/Voice/Voice_CS_FR602_02_cs_rus.bsb",
    "ogg": "voice/03.ogg",
    "mp3": "voice/03.mp3",
    "duration": 1.987
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Похоже, стоит готовиться к худшему...",
    "en": "We should prepare for the worst...",
    "fr": "Nous devrions nous préparer au pire..."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/Swarm_Sub_3.(ClientData).xdb"
  },
  {
   "n": 4,
   "start": 34.0,
   "duration": 10.0,
   "speaker": "rysina",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_SwarmRysina05",
    "wave": "CS_FR_SwarmRysina05",
    "bank": "SFX/Voice/Voice_CS_FR602_02_cs_rus.bsb",
    "ogg": "voice/04.ogg",
    "mp3": "voice/04.mp3",
    "duration": 5.863
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Да, стоит... Им! Гляньте - они уже убегают. Мудрое решение!",
    "en": "Ahem... Look at them - they are already running. A wise decision!",
    "fr": "Hum... Regardez-les, ils courent déjà. Une sage décision !"
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/Swarm_Sub_4.(ClientData).xdb"
  },
  {
   "n": 5,
   "start": 40.0,
   "duration": 10.0,
   "speaker": "diarder",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_SwarmMarianna06",
    "wave": "CS_FR_SwarmMarianna06",
    "bank": "SFX/Voice/Voice_CS_FR602_02_cs_rus.bsb",
    "ogg": "voice/05.ogg",
    "mp3": "voice/05.mp3",
    "duration": 5.756
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Я попробую открыть портал... Но лишь Тенсес ведает, что ждёт нас на той стороне!",
    "en": "I will try to open the portal... But only Tensess knows what is waiting for us on the other side!",
    "fr": "J'essaierai d'ouvrir le portail... Tensess seul sait ce qui nous attend de l'autre côté !"
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/Swarm_Sub_5.(ClientData).xdb"
  },
  {
   "n": 6,
   "start": 46.0,
   "duration": 10.0,
   "speaker": "rysina",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_SwarmRysina06",
    "wave": "CS_FR_SwarmRysina06",
    "bank": "SFX/Voice/Voice_CS_FR602_02_cs_rus.bsb",
    "ogg": "voice/06.ogg",
    "mp3": "voice/06.mp3",
    "duration": 4.318
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Пускай. Чем быстрее мы атакуем, тем чаще враг ошибается!",
    "en": "Let it be so. The faster we attack, the more often the enemy fails!",
    "fr": "Qu'il en soit ainsi. Plus vite nous attaquerons et plus d'ennemis échoueront !"
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/Swarm_Sub_6.(ClientData).xdb"
  },
  {
   "n": 7,
   "start": 50.0,
   "duration": 10.0,
   "speaker": "diarder",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_SwarmMarianna07",
    "wave": "CS_FR_SwarmMarianna07",
    "bank": "SFX/Voice/Voice_CS_FR602_02_cs_rus.bsb",
    "ogg": "voice/07.ogg",
    "mp3": "voice/07.mp3",
    "duration": 2.365
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Вот только у нас права на ошибку нет...",
    "en": "But we don't have the right to make mistakes...",
    "fr": "Mais n'avons pas le droit à l'erreur..."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/Swarm_Sub_7.(ClientData).xdb"
  }
 ],
