 "lines": [
  {
   "n": 1,
   "start": 0.0,
   "duration": 17.0,
   "speaker": null,
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_PortalArch02",
    "wave": "CS_FR_PortalArch02",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/01.ogg",
    "mp3": "voice/01.mp3",
    "duration": 5.42
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Наслаждайтесь своим преимуществом. Оно продлится недолго.",
    "en": "Enjoy your advantage. It will not last.",
    "fr": "Profitez de votre avantage. Il ne durera pas."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/Portal_end_Sub1.(ClientData).xdb"
  },
  {
   "n": 2,
   "start": 6.0,
   "duration": 17.0,
   "speaker": null,
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_PortalArch03",
    "wave": "CS_FR_PortalArch03",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/02.ogg",
    "mp3": "voice/02.mp3",
    "duration": 6.198
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Вы все будете преобразованы. Скоро...",
    "en": "You all will be transmuted. Soon...",
    "fr": "Vous allez tous être transmutés. Bientôt..."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/Portal_end_Sub2.(ClientData).xdb"
  },
  {
   "n": 3,
   "start": 16.0,
   "duration": 17.0,
   "speaker": "diarder",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_PortalMarianna06",
    "wave": "CS_FR_PortalMarianna06",
    "bank": "SFX/Voice/Voice_CS_FR602_02_cs_rus.bsb",
    "ogg": "voice/03.ogg",
    "mp3": "voice/03.mp3",
    "duration": 3.653
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Что ж... Вот и всё. Обратного пути нет.",
    "en": "Well, that's it... There is no way back.",
    "fr": "Nous y voilà... Il est impossible de faire marche arrière."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/Portal_end_Sub3.(ClientData).xdb"
  },
  {
   "n": 4,
   "start": 22.0,
   "duration": 17.0,
   "speaker": "rysina",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_PortalRysina03",
    "wave": "CS_FR_PortalRysina03",
    "bank": "SFX/Voice/Voice_CS_FR602_02_cs_rus.bsb",
    "ogg": "voice/04.ogg",
    "mp3": "voice/04.mp3",
    "duration": 5.058
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Отличная работа. Архитекторы определённо смертны. Это радует.",
    "en": "Great job. Now we know that the Architects are definitely mortal.",
    "fr": "Bon travail. Nous savons désormais que les Architectes sont mortels."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/Portal_end_Sub4.(ClientData).xdb"
  },
  {
   "n": 5,
   "start": 29.0,
   "duration": 17.0,
   "speaker": "rysina",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_PortalRysina04",
    "wave": "CS_FR_PortalRysina04",
    "bank": "SFX/Voice/Voice_CS_FR602_02_cs_rus.bsb",
    "ogg": "voice/05.ogg",
    "mp3": "voice/05.mp3",
    "duration": 3.044
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Какое странное место... Ты чувствуешь?",
    "en": "What a weird place... Can you feel it?",
    "fr": "Quel étrange endroit. Le sentez-vous ?"
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/Portal_end_Sub5.(ClientData).xdb"
  },
  {
   "n": 6,
   "start": 36.0,
   "duration": 17.0,
   "speaker": "diarder-2",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_PortalMarianna07",
    "wave": "CS_FR_PortalMarianna07",
    "bank": "SFX/Voice/Voice_CS_FR602_02_cs_rus.bsb",
    "ogg": "voice/06.ogg",
    "mp3": "voice/06.mp3",
    "duration": 6.006
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Какая-то энергия... Или пульсация... Не пойму, но у нас нет выбора. Вперёд!",
    "en": "Some kind of energy... or pulsation... I don't get it, but we have no choice. Let's go!",
    "fr": "Une sorte d'énergie... ou de pulsation... Je ne comprends pas, mais nous n'avons pas le choix. Allons-y !"
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/Portal_end_Sub6.(ClientData).xdb"
  }
 ],
