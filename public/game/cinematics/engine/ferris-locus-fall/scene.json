   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Невероятно...",
    "en": "Unbelievable...",
    "fr": "Incroyable..."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastDie_Sub16.(ClientData).xdb"
