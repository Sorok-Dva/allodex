   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Оглянитесь!",
    "en": "Look around!",
    "fr": "Regardez autour de vous !"
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastDie_Sub9.(ClientData).xdb"
  },
  {
   "n": 10,
