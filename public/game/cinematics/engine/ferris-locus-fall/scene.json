   "voice": null,
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Уходите. Возвращайтесь. И запомните, создания Хаоса - Порядок не изменить!",
    "en": "Go away. Go back. Remember, children of chaos: the Order is impregnable!",
    "fr": "Allez-vous-en. Repartez. Rappelez-vous, enfants du chaos : l'Ordre est inviolable !"
   },
