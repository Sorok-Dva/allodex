    "ogg": "voice/01.ogg",
    "mp3": "voice/01.mp3",
    "duration": 3.337
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Гармонии больше нет... Порядок нарушен... Локус... Не нужен больше...",
    "en": "The harmony is gone... The Order is broken... Locus... Is no longer needed...",
    "fr": "L'harmonie a disparu... L'Ordre est rompu... Le Locus... n'est plus nécessaire..."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastDie_Sub1.(ClientData).xdb"
  },
  {
   "n": 2,
   "start": 18.0,
   "duration": 11.0,
   "speaker": "rysina",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierRysina04",
    "wave": "CS_FR_CarrierRysina04",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/02.ogg",
    "mp3": "voice/02.mp3",
    "duration": 2.231
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Стать совершенными, говоришь?",
    "en": "To become perfect, you say?",
    "fr": "Devenir parfait, dites-vous ?"
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastDie_Sub2.(ClientData).xdb"
  },
  {
   "n": 3,
   "start": 23.0,
   "duration": 2.0,
   "speaker": "rysina",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierRysina05",
    "wave": "CS_FR_CarrierRysina05",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/03.ogg",
    "mp3": "voice/03.mp3",
    "duration": 3.562
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Ой... Я растоптала совершенство!",
    "en": "Oh... I stepped on a perfectness!",
    "fr": "Oh... J'ai marché sur la perfection !"
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastDie_Sub3.(ClientData).xdb"
  },
  {
   "n": 4,
   "start": 29.0,
   "duration": 2.0,
   "speaker": "rysina",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierRysina06",
    "wave": "CS_FR_CarrierRysina06",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/04.ogg",
    "mp3": "voice/04.mp3",
    "duration": 1.659
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Эй, что происходит?",
    "en": "Hey, what's going on?",
    "fr": "Que se passe-t-il ?"
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastDie_Sub4.(ClientData).xdb"
  },
  {
   "n": 5,
   "start": 33.0,
   "duration": 4.0,
   "speaker": "diarder",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierMarianna02",
    "wave": "CS_FR_CarrierMarianna02",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/05.ogg",
    "mp3": "voice/05.mp3",
    "duration": 3.006
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Локус разрушает сам себя! Бежим!",
    "en": "Locus is destroying itself! Run!",
    "fr": "Le Locus se détruit lui-même ! Courez !"
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastDie_Sub5.(ClientData).xdb"
  },
  {
   "n": 6,
   "start": 39.0,
   "duration": 2.0,
   "speaker": "rysina",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierRysina07",
    "wave": "CS_FR_CarrierRysina07",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/06.ogg",
    "mp3": "voice/06.mp3",
    "duration": 1.72
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Ходу, ходу!",
    "en": "Go, go!",
    "fr": "Allez, allez !"
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastDie_Sub6.(ClientData).xdb"
  },
  {
   "n": 7,
   "start": 47.0,
   "duration": 4.0,
   "speaker": "diarder",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierMarianna03",
    "wave": "CS_FR_CarrierMarianna03",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/07.ogg",
    "mp3": "voice/07.mp3",
    "duration": 5.062
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Ох... Храни нас Свет. Теперь, когда всё закончилось...",
    "en": "Oh... may the Light save us. Now, when everything's over...",
    "fr": "Oh... puisse la Lumière nous sauver. Maintenant, tout est terminé..."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastDie_Sub7.(ClientData).xdb"
  },
  {
   "n": 8,
   "start": 53.5,
   "duration": 2.0,
   "speaker": "colossus",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierVayatel08",
    "wave": "CS_FR_CarrierVayatel08",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
    "ogg": "voice/08.ogg",
    "mp3": "voice/08.mp3",
    "duration": 3.006
   },
   "clips": [],
   "animations": [],
   "text": {
    "ru": "Ничего не закончилось.",
    "en": "Nothing is over.",
    "fr": "Rien n'est terminé."
   },
   "source": "World/Quests/Ferris_indoor/Ferris_3_4_2/LastDie_Sub8.(ClientData).xdb"
  },
  {
   "n": 9,
   "start": 60.5,
   "duration": 2.0,
   "speaker": "colossus",
   "voice": {
    "event": "Cutscenes/Ferris4/CS_FR_CarrierVayatel09",
    "wave": "CS_FR_CarrierVayatel09",
    "bank": "SFX/Voice/Voice_CS_FR602_cs_rus.bsb",
