[["dialogues","r506942","[Tell Murk what happened]",0],["dialogues","r506943","Aho, friends! I'm glad you made it!",0],["dialogues","r507064","What is this place?",0],["dialogues","r507065","What's going on here?",0],["dialogues","r507066","I don't know where to go.",0],["dialogues","r507067","Greetings, ! What would you like to know?",0],["dialogues","r507163","Who are you?",0],["dialogues","r507164","What do you do here?",0],["dialogues","r507170","Greetings, traveler!",0],["dialogues","r507181","What do you do here?",0],["dialogues","r507182","Who are you?",0],["dialogues","r507183","It's nice to see you here, Stormbringer!",0],["dialogues","r507184","What do you do here?",0],["dialogues","r507185","Who are you?",0],["dialogues","r507189","What do you do here?",0],["dialogues","r507190","Who are you?",0],["dialogues","r507191","Hello, hello!",0],["dialogues","r507194","Oh my, look who is here!",0],["dialogues","r507195","What do you do here?",0],["dialogues","r507196","Who are you?",0],["dialogues","r507197","Hey, hey. Quiet! Since you've recognized me, you understand why I have…",0],["dialogues","r507198","What do you do here?",0],["dialogues","r507199","Who are you?",0],["dialogues","r507206","I'm happy to see you here among the elven people!",0],["dialogues","r507209","What do you do here?",0],["dialogues","r507210","Who are you?",0],["dialogues","r507212","Hello!",0],["dialogues","r507213","What do you do here?",0],["dialogues","r507214","Who are you?",0],["dialogues","r507215","Greetings!",0],["dialogues","r507220","What do you do here?",0],["dialogues","r507221","Who are you?",0],["dialogues","r507222","What do you do here?",0],["dialogues","r507223","Who are you?",0],["dialogues","r507224","Let's welcome our important guest! Perhaps you need a costume? I'll be…",0],["dialogues","r507225","Greetings! What brings you to Irene?",0],["dialogues","r507228","What do you do here?",0],["dialogues","r507229","Who are you?",0],["dialogues","r507230","I'm happy to see you again after so many years.",0],["dialogues","r507231","What do you do here?",0],["dialogues","r507232","Who are you?",0],["dialogues","r507237","You don't need to bend the knee, there's no time for formalities.",0],["dialogues","r507238","Who are you?",0],["dialogues","r507239","What do you do here?",0],["dialogues","r507240","Ah, it's you.",0],["dialogues","r507241","What do you do here?",0],["dialogues","r507242","Who are you?",0],["dialogues","r507245","What do you do here?",0],["dialogues","r507246","Who are you?",0],["dialogues","r507247","Oh, a familiar face! I wonder where I've seen you before. I know you...",0],["dialogues","r507252","Greetings, from the bottom of my heart!",0],["dialogues","r507253","Who are you?",0],["dialogues","r507254","What do you do here?",0],["dialogues","r507255","What do you do here?",0],["dialogues","r507256","Who are you?",0],["dialogues","r507257","Hello yourself!",0],["dialogues","r507258","Welcome to Irene!",0],["dialogues","r507259","Who are you?",0],["dialogues","r507260","What do you do here?",0],["dialogues","r507261","Greetings! It's nice and peaceful here on Irene! Quite a nice change…",0],["dialogues","r507268","What do you do here?",0],["dialogues","r507269","Who are you?",0],["dialogues","r507275","What do you do here?",0],["dialogues","r507276","Who are you?",0]]