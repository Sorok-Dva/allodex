ep, we are going ahead!",0],["dialogues","r245726","Tell about the vision",4],["dialogues","r245727","Here the Threads intertwine in a strange Pattern...",0],["dialogues","r245732","I'm dying... Help me...",0],["dialogues","r245749","The stone is cold and grim. The names of girls, who fell in battle…",0],["dialogues","r245750","The cold stone reads: Yela Komelkova Rita Osanina Lisa Brichkina Galia…",0],["dialogues","r246063","Philosophy, huh?",0],["dialogues","r246065","Get a Philosopher Degree",0],["dialogues","r246066","What is the NSHU?",0],["dialogues","r246067","Greetings, Stormbringer! Today is the day of wisdom!",0],["dialogues","r246083","Hmm, you look familiar...",0],["dialogues","r246085","Get a Scientist Degree",0],["dialogues","r246086","Greetings.",0],["dialogues","r246089","You look familiar.",0],["dialogues","r246091","Get a Historian Degree",0],["dialogues","r246092","Greetings!",0],["dialogues","r246172","Report that spiders were killed",0],["dialogues","r246173","There are spiders around here! While I waited here, I learned more…",0],["dialogues","r246219","Two-weeks’ competition",0],["dialogues","r246220","Olympics",0],["dialogues","r246221","My rating",0],["dialogues","r246222","Rewards",0],["dialogues","r246224","Two-Weeks’ Competition",0],["dialogues","r246225","Dionic Olympics",0],["dialogues","r246226","About the Dionic Olympics",0],["dialogues","r246227","Dionic Olympics are where the true champions of Dionic Games meet!",0],["dialogues","r246436","What do you need with this Uro-Boros?",0],["dialogues","r246437","How do we catch Uro-Boros?",0],["dialogues","r246438","How did you wind up on Suslanger?",0],["dialogues","r246439","That sounds familiar...",0]]