"r502853","Any new rumors or gossips?",0],["dialogues","r502854","Good afternoon!",0],["dialogues","r502881","Hello!",0],["dialogues","r502882","Can I help you?",0],["dialogues","r502884","Can I help you?",0],["dialogues","r502886","Can I help you?",0],["dialogues","r502888","Can I help you?",0],["dialogues","r502890","Hello! I need food.",0],["dialogues","r502891","Hello! Oh, why am I so bored in a place like this?",0],["dialogues","r503002","Fairies? Who are you? Why do you need them?",0],["dialogues","r503004","House de Avale? Never heard of it.",0],["dialogues","r503006","Oh, Irene! The motherland of magic fairies! I'm dreaming to find them!",0],["dialogues","r503009","House de Ark? What House is that?",0],["dialogues","r503011","And who are you?",0],["dialogues","r503012","I've never heard about House de Amfas. Tell me about it.",0],["dialogues","r503013","Likewise. And who are you?",0],["dialogues","r503014","Tell me about yourself.",0],["dialogues","r503015","I've never heard about House de Venar.",0],["dialogues","r503016","Good afternoon! Tell me about yourself.",0],["dialogues","r503017","Greetings. I think we've met.",0],["dialogues","r503018","Greetings! Oh, the charming antiquity! Irene is amazing, isn't it?",0],["dialogues","r503019","House de Gloire? Is this a thing?",0],["dialogues","r503020","Oh, what joy, what beauty! Just look around you! It's like in the good…",0],["dialogues","r503021","Glory to you, my good friend. I'm glad to see you on Irene.",0],["dialogues","r503022","I need to know about your House.",0],["dialogues","r503023","Harmony de Conte, traveling minstrel, at your service!",0],["dialogues","r503028","I would love for the Great Ball to start! I can't wait to dance!",0],["dialogues","r503032","Who are you? What are you afraid of?",0],["dialogues","r503033","Greetings to you, too. What's your name?",0]]