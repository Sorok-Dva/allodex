[["dialogues","r488184","Voilà le cadavre de l'écureuil. Faites encore une erreur comme ça avec moi, et vous…",0],["dialogues","r488185","Toutes sortes de fainéants traînent par ici...",0],["dialogues","r488191","[L'écureuil vous regarde, vous lui rendez son regard]",0],["dialogues","r488281","Vous avez parlé avec l'Intendant ?",0],["dialogues","r488282","Vous avez parlé avec l'Intendant ?",0],["dialogues","r488283","Bonjour ! Quoi de neuf ?",0],["dialogues","r488288","Je le ferai, à l'occasion.",0],["dialogues","r488289","Très bien, continuez.",0],["dialogues","r488290","Voulez-vous enfin me dire où se trouve l'artefact ?",0],["dialogues","r488291","Je suis ravi. Maintenant, l'artefact...",0],["dialogues","r488292","C'est toute une aventure pour vous retrouver ! Je fais des recherches pour... vous…",0],["dialogues","r488293","Oui ? Je peux vous aider ?",0],["dialogues","r488300","Vous avez parlé avec l'Intendant ?",0],["dialogues","r488301","Vous avez parlé avec l'Intendant ?",0],["dialogues","r488302","Bonjour ! Vous cherchez quelque chose ?",0],["dialogues","r488304","Je cherche l'Intendant. Vous ne l'avez pas vu ?",0],["dialogues","r488305","L'Intendant est ici ?",0],["dialogues","r488306","Bonjour ! Comment allez-vous ?",0],["dialogues","r488321","Qui est le plus digne de notre protection ?",0],["dialogues","r488324","Oui.",0],["dialogues","r488325","La Grandeur.",0],["dialogues","r488326","Les dragons.",0],["dialogues","r488327","Les Abysses.",0],["dialogues","r488328","Une Malédiction.",0],["dialogues","r488329","Un mensonge.",0],["dialogues","r488330","Que vaut mieux-t-il savoir en premier lieu ?",0],["dialogues","r488331","Qui aimons-nous vraiment ?",0],["dialogues","r488332","Je suis prêt.",0],["dialogues","r488333","Je...suis... Pas encore prêt",0],["dialogues","r488334","Seul celui ou celle qui comprend notre histoire est autorisé à aller…",0],["dialogues","r488337","Déchiffrer",0],["dialogues","r488338","Déchiffrer",0],["dialogues","r488340","La stèle est couverte d'inscriptions Junes.",0],["dialogues","r488343","“Tu as pris mon coeur. Je vais donc prendre le tien”, déclare…",0],["dialogues","r488351","La stèle est couverte d'inscriptions Junes.",0],["dialogues","r488355","La stèle est couverte d'inscriptions Junes.",0],["dialogues","r488371","La Vie.",0],["dialogues","r488372","L'Honneur.",0],["dialogues","r488373","L'Aspiration.",0],["dialogues","r488374","Répondre à la question",0],["dialogues","r488378","Une autre vie.",0],["dialogues","r488379","Rien.",0],["dialogues","r488380","Le dieu supérieur",0],["dialogues","r488381","Répondre à la question",0],["dialogues","r488385","Les plasirs.",0],["dialogues","r488386","La Connaissance.",0],["dialogues","r488387","La Puissance",0],["dialogues","r488388","Répondre à la question",0],["dialogues","r488389","La Stèle attend votre action.",0],["dialogues","r488390","Le jeu de Nihaz a commencé. Veuillez attendre la fin de la partie pour…",0],["dialogues","r488448","Suivre la réminiscence",0],["dialogues","r488449","Suivre la réminiscence",0],["dialogues","r488450","Entrer en transe",0],["dialogues","r488451","Stop !",0],["dialogues","r488452","Qu'est-ce que vous voulez ?",0],["dialogues","r488465","Bien, je vais les chercher.",0],["dialogues","r488471","Que dois-je faire ?",0],["dialogues","r488479","Alors ? Allez-vous m'aider ?",0],["dialogues","r488480","Alors ? Allez-vous m'aider ?",0],["dialogues","r488481","Yk Ome Nuntley.",0],["dialogues","r488487","Yk Ome Nuntley.",0],["dialogues","r488493","Yk Ome Nuntley.",0],["dialogues","r488499","Yk Ome Nuntley.",0],["dialogues","r488505","Yk Ome Nuntley.",0]]