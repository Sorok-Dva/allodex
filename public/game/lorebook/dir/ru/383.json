[["dialogues","r488133","Вы видите очередную страницу дневника.",0],["dialogues","r488155","Разреши же мне забрать твою Искру…",0],["dialogues","r488156","Что думаешь о Нихазе и его игре?",0],["dialogues","r488157","Что ты знаешь о Тка-Рике?",0],["dialogues","r488158","Что ты помнишь?",0],["dialogues","r488159","Приветствую тебя, о Лу-а-Джалла!",0],["dialogues","r488160","Кто ты? Где мой возлюбленный Ат-Зако?...",0],["dialogues","r488165","Развернуть страницу дневника",0],["dialogues","r488166","Вы видите аккуратно свернутую страницу дневника…",0],["dialogues","r488172","[Нарисовать табличку на песке]",0],["dialogues","r488173","Белка-то тебе зачем?",0],["dialogues","r488174","Она мне очень нужна. Отдашь?",0],["dialogues","r488175","Табличка - это небольшая пластина с информирующей о чем-либо надписью.",0],["dialogues","r488177","Квадратная такая, а на ней буквы всякие.",0],["dialogues","r488178","Э... Привет. Ты вроде мирный, в отличие от своих сородичей. Не знаешь кого-нибудь, кто…",0],["dialogues","r488180","Вот белка. Что дальше?",0],["dialogues","r488182","На самом деле тебе нужна не белка. Тебе нужна дружба и внимание, но твоё окружение не…",0],["dialogues","r488184","Вот труп белки. Будешь еще отбирать моё время - присоединишься к ней.",0],["dialogues","r488185","Опять ходят тут… Мешают…",0],["dialogues","r488191","[Белка смотрит на вас, вы смотрите на белку]",0],["dialogues","r488281","Ты видел зав.склада?",0],["dialogues","r488282","Зав.склада тут не видал?",0],["dialogues","r488283","Привет. Чем занимаешься?",0],["dialogues","r488288","При случае - обязательно.",0],["dialogues","r488289","Так, продолжайте.",0],["dialogues","r488290","Да скажешь ты в конце-концов, где артефакт?!",0],["dialogues","r488291","Да, конечно, очень польщен, но все-таки артефакт...",0],["dialogues","r488292","Ну и сложно ж Вас поймать! Я занимаюсь поисками для... Историков, в общем. И в руинах…",0],["dialogues","r488293","Да, чем-то могу помочь?",0],["dialogues","r488300","Зав.склада может быть встречал?",0],["dialogues","r488301","Ты случаем не знаешь, где зав.склад?",0],["dialogues","r488302","Привет. Что забыл?",0],["dialogues","r488304","Я срочно ищу зав.склада! Ты его видел?",0],["dialogues","r488305","Зав.склада тут или нет?",0],["dialogues","r488306","Привет. Как жизнь?",0],["dialogues","r488321","Кого стоит беречь больше всего?",0],["dialogues","r488324","Да.",0],["dialogues","r488325","Величие.",0],["dialogues","r488326","Драконы.",0],["dialogues","r488327","Бездна.",0],["dialogues","r488328","Проклятие.",0],["dialogues","r488329","Ложь.",0],["dialogues","r488330","Что стоит познать в первую очередь?",0],["dialogues","r488331","Кого мы любим на самом деле?",0],["dialogues","r488332","Я готов.",0],["dialogues","r488333","Я... Ещё не готов.",0],["dialogues","r488334","Лишь тот, кто понял нашу историю, достоин пройти далее.",0],["dialogues","r488337","Расшифровать",0],["dialogues","r488338","Расшифровать",0],["dialogues","r488340","Стела испещрена джунским текстом.",0],["dialogues","r488343","- Раз ты отняла моё сердце, я отниму у тебя твоё. – говорит…",0],["dialogues","r488351","Стела испещрена джунским текстом.",0],["dialogues","r488355","Стела испещрена джунским текстом.",0],["dialogues","r488371","Жизнь.",0],["dialogues","r488372","Честь.",0],["dialogues","r488373","Стремления.",0],["dialogues","r488374","Ответить на вопрос",0],["dialogues","r488378","Ради другой жизни.",0],["dialogues","r488379","Ничто не стоит таких жертв.",0],["dialogues","r488380","Ради высшего блага.",0],["dialogues","r488381","Ответить на вопрос",0],["dialogues","r488385","Ради удовольствий.",0],["dialogues","r488386","Ради познания.",0],["dialogues","r488387","Ради власти.",0]]