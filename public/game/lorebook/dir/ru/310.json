[["dialogues","r181445","Как бы вы охарактеризовали общий прогресс вашего участка работ на данный момент?",2],["dialogues","r181450","Как продвигается работа?",2],["dialogues","r181451","На чем планируете сосредоточиться в первую очередь завтра?",2],["dialogues","r181487","Хо-хорошо, Рик... А если я вот эту квантовую штуку не туда прикручу,…",2],["dialogues","r181540","Эти опасные эксперименты Рика! Неужели никто из начальства не обращает…",2],["dialogues","r181605","Начнём?",2],["dialogues","r181606","В чем суть задания?",2],["dialogues","r181611","Начнём?",2],["dialogues","r181612","В чем суть задания?",2],["dialogues","r181613","Начнём?",2],["dialogues","r181615","Я выбираю первый портал!",2],["dialogues","r181616","Я выбираю второй портал!",2],["dialogues","r181617","Я выбираю третий портал!",2],["dialogues","r181618","Я хочу выбрать портал!",2],["dialogues","r181621","Начнём третий эксперимент!",2],["dialogues","r181622","Выйти наружу",2],["dialogues","r181623","И вот мы здесь…",2],["dialogues","r181755","Ну, и как тут работать? Надо загрызут раньше, чем мы закрутим гайку!",2],["dialogues","r181786","Так, а где же мой молоток? Куда он пропал?!",2],["dialogues","r181811","Пошли со мной!",2],["dialogues","r181812","Я лично видел, как они рабочего повалили и разорвали на части!",2],["dialogues","r181834","Надеюсь, никто не пострадал? Кажется, все успели убежать!",2],["dialogues","r181859","Кажется, я знаю, как поступить с этими змеями-многоглавами...",2],["dialogues","r181870","Как тебе помочь, чтобы вы вернулись к работе?",2],["dialogues","r181871","Что тут случилось?",2],["dialogues","r181872","Это полный бардак!",2],["dialogues","r181880","И вот мы здесь…",2],["dialogues","r181883","Что нужно сделать?",2],["dialogues","r181884","Что у вас тут происходит? Нужна помочь с культистами?",2],["dialogues","r181885","Что будем делать?",2],["dialogues","r181886","И что, они выжили?",2],["dialogues","r181887","А что нужно проверить?",2],["dialogues","r181888","А что за пушка?",2],["dialogues","r181889","П-привет, биомасса! Ты здесь, чтобы… эээ…. помочь или стать удобрением…",2],["dialogues","r181926","Слушать дальше…",2],["dialogues","r181937","Слушать дальше…",2],["dialogues","r181947","Слушать дальше…",2],["dialogues","r181973","Пошли со мной!",2],["dialogues","r181974","Мои бедные ножки!",2],["dialogues","r182019","Что будем делать?",2],["dialogues","r182020","Что происходит?",2],["dialogues","r182021","Что будем делать?",2],["dialogues","r182022","Что расскажешь?",2],["dialogues","r182023","Пошли со мной!",2],["dialogues","r182024","А у тебя как дела?",2],["dialogues","r182025","Мы всех разбили!",2],["dialogues","r182026","Вот уж не ожидала, что мы здесь окажемся в зоне боевых действий! Но,…",2],["dialogues","r182029","Ладно, давай удачи тебе!",2],["dialogues","r182030","Как прокомментируешь?",2],["dialogues","r182031","Вот те на, без шефа остались, так тут ещё и война под боком!",2],["dialogues","r182070","Да когда ж они разойдутся…",2],["dialogues","r182100","О ком ты говоришь?",2],["dialogues","r182101","Пути света неисповедимы!",2],["dialogues","r182102","Для Света нет разницы - из плоти ли мы или из металла!",2],["dialogues","r182107","Тут Негус Кхай, кажется, умом тронулся…",2],["dialogues","r182108","Всё это весьма необычно!",2],["dialogues","r182109","Мы с Интегралом проследим, чтобы здесь всё было в порядке!",2],["dialogues","r182112","Что с ним такое?",2],["dialogues","r182113","Свихнулся… Однозначно!",2],["dialogues","r182114","К трудовым подвигам - готовы!",2],["dialogues","r182131","Меня просят принести новую лопату",2],["dialogues","r182132","Как успехи?",2],["dialogues","r182133","Что случилось такое?",2],["dialogues","r182134","Не, ну ты видела? Видела?!",2]]