[["dialogues","r138948","Допросить",0],["dialogues","r138949","Всякого я в жизни повидал, но такого - и представить не могу.",0],["dialogues","r138967","Отправиться в путь",0],["dialogues","r138968","Рассказать о грядущем взрыве",0],["dialogues","r138980","Отправиться дальше",0],["dialogues","r138981","Рассказать об архонте",0],["dialogues","r138982","Вперёд! Клянусь, сегодня знамя нашей Победы взовьётся над этой…",0],["dialogues","r139152","Начать сложный бой",0],["dialogues","r139154","Начать обычный бой",0],["dialogues","r139164","Доложить о взятии высоты «Воробей»",0],["dialogues","r139165","Ну что, как обстановка? Можно идти аль погодить чутка?",0],["dialogues","r139451","Согласиться помочь",0],["dialogues","r139452","Спросить, что происходит",0],["dialogues","r139455","Согласиться",0],["dialogues","r139456","Спросить причину остановки",0],["dialogues","r139457","Наконец-то подмога! А мы уж было думали, что на помощь из…",0],["dialogues","r139485","Понимающе кивнуть",0],["dialogues","r139486","Разузнать детали плана",0],["dialogues","r139487","Ахо! Хочешь спр-росить меня о чём-то, зур?",0],["dialogues","r139524","Солгать, что вы готовы принять Путь",0],["dialogues","r139525","Заявить, что вы его уже остановили",0],["dialogues","r139526","Спросить, почему Порядок до сих пор не победил Хаос",0],["dialogues","r139679","Призвать к оружию",0],["dialogues","r139680","Кха... Кха... Чем нас отравили? Этот туман... Как больно...",0],["dialogues","r139687","Войти в искажение",0],["dialogues","r139688","Пространство вокруг искажения времени плывёт и дрожит едва заметным…",0],["dialogues","r139724","Продемонстрировать останки убийцы",0],["dialogues","r139725","Ну, какие новости? Нашли убийцу?",0],["dialogues","r139764","Величайший некромант Сарнаута",4],["dialogues","r139765","Бог Света",0],["dialogues","r139766","... окровавленный труп надоедливого лекаришки!",0],["dialogues","r139767","Доктор, заканчивайте клоунаду!",0],["dialogues","r139768","Потому что может",0],["dialogues","r139769","Потому что астрал является хаотичной нестабильной праматерией",0],["dialogues","r139770","Великий Маг прошлого, канонизированный церковью",0],["dialogues","r139771","Чокнутый психопат",0],["dialogues","r139772","Понятия не имею!",0],["dialogues","r139773","Соврать что-нибудь заумное",0],["dialogues","r139959","Спросить о текущей диспозиции",0],["dialogues","r139960","Твари хотят войны? Они получат войну, не будь я Иван Железный!",0],["dialogues","r139999","Сообщить о готовности",0],["dialogues","r140000","Ахо, дружище! Здесь вроде бы спокойно, но не тер-ряй бдительности -…",0],["dialogues","r140017","Спросить про переправу",0],["dialogues","r140018","Расспросить про архитекторов",0],["dialogues","r140019","Расспросить про мятеж",0],["dialogues","r140022","Замаскироваться",0],["dialogues","r140023","Что ты здесь делаешь, глупый землюк? Это наше озеро! Мы маленький…",0],["dialogues","r140034","Поговорить про предательство Рохлина",0],["dialogues","r140035","Ну, чё надо? Давай, не мнись, некогда мне тут с тобой языком трепать -…",0],["dialogues","r140134","Спросить о дальнейших действиях",0],["dialogues","r140135","Здравия желаем!",0],["dialogues","r140176","Перетряхнуть сумку",0],["dialogues","r140177","В сумке полно разнообразного хлама. Похоже, Жора просто тырил всё, что…",0],["dialogues","r140182","Осмотреть топор",0],["dialogues","r140183","Самый обычный топор для рубки дров, таких в лагере полно. А вот удары…",0],["dialogues","r140193","Расспросить о Рубиле",0],["dialogues","r140194","Расспросить о Рубиле",0],["dialogues","r140195","Расспросить о Рубиле",0],["dialogues","r140196","Ты кто? Чего тебе нужно?",0],["dialogues","r140242","Расспросить чародея",0],["dialogues","r140243","Ох... Вы... Вас прислал Иван, да? У нас тут какой-то кошмар творится!…",0],["dialogues","r140262","Рассказать про клеймо на топоре",0],["dialogues","r140263","Ахо! О чём ты хочешь меня спр-росить?",0],["dialogues","r140308","Запугать Седогрива",0]]