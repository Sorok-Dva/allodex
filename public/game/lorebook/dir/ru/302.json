[["dialogues","r172014","Было бы неплохо отдохнуть после всего этого",0],["dialogues","r172015","Что думаешь по поводу дальнейших планов Эллекена и судьбы Черепа?",0],["dialogues","r172016","Почему мне не помогли в сражении с Эллекеном?",0],["dialogues","r172017","[Рассказать Найану о том, что случилось]",0],["dialogues","r172018","! Вы оба здесь… Что произошло?",0],["dialogues","r172037","Ты не нападаешь? Мне нужно пройти дальше!",0],["dialogues","r172038","Могучий герой пришёл, как Странник и обещал! От тебя пахнет кровью……",0],["dialogues","r172082","Я не могу просто стоять и ждать, Эвриаль. Слишком много тайн.",0],["dialogues","r172083","Что с Черепом? Он где-то здесь?",0],["dialogues","r172084","Что здесь происходит?",0],["dialogues","r172085","Я не могу просто стоять и ждать, Эвриаль. Слишком много тайн.",0],["dialogues","r172086","Вот вы и почти докопались до правды… Буквально.",0],["dialogues","r172118","Кому – бал, а кому – работа…",0],["dialogues","r172123","Ты уверена в своей победе?",0],["dialogues","r172124","И снова здравствуй, . Ренар неплохо потрудился. Когда он не лезет в…",0],["dialogues","r172126","Какой Дом ты поддержишь в голосовании?",0],["dialogues","r172127","Это было грандиозно! Всегда мечтала увидеть унижение Ренара, а тебе…",0],["dialogues","r172130","Мой голос отдан Дому ди Делис!",0],["dialogues","r172131","Выигрывать очень приятно! Я знала, что наши труды рано или поздно…",0],["dialogues","r172132","Да, все так… Напомнишь, что ты вчера видела? Череп куда-то пропал.",0],["dialogues","r172133","! Дай угадаю – голова раскалывается, а вспомнить ничего не можешь?",0],["dialogues","r172169","Что же делать?",0],["dialogues","r172264","Что ты задумал?",0],["dialogues","r172265","Разве ты сам не бессмертен?",0],["dialogues","r172266","Зачем ты делаешь это?",0],["dialogues","r172267","Похоже, мои дорогие друзья боятся показать здесь свой нос. Внезапно…",0],["dialogues","r172276","Что тут произошло?",0],["dialogues","r172277","Кто здесь?!",0],["dialogues","r172370","Побежали!",0],["dialogues","r172371","Единорог готов бежать и ожидает команды.",0],["dialogues","r172384","Выразить готовность",0],["dialogues","r172385","Что дальше?",0],["dialogues","r172386","Единорог побеждён!",0],["dialogues","r172388","Здравствуй. Отличный день для спорта!",0],["dialogues","r172414","И как тебе моя музыка?",0],["dialogues","r172415","А, здравствуй-здравствуй... Ик.",0],["dialogues","r172419","Я — хранитель переправы. Куда желаешь отправиться?",0],["dialogues","r172459","Перераспределить характеристики. Израсходуется {value}",0],["dialogues","r172460","Перераспределить характеристики",0],["dialogues","r172477","Перераспределить умения. Израсходуется {value}",0],["dialogues","r172478","Перераспределить умения",0],["dialogues","r172479","Перераспределить характеристики",0],["dialogues","r172480","Перераспределить умения",0],["dialogues","r172482","Перераспределить характеристики с помощью Концентрата Живой воды.",0],["dialogues","r172484","Перераспределить умения с помощью Концентрата Мёртвой воды.",0],["dialogues","r172485","Перераспределить умения, заплатив {value}",0],["dialogues","r172486","Перераспределить характеристики, заплатив {value}",0],["dialogues","r172527","Отдать зелье",0],["dialogues","r172543","Разузнать о Царстве Природы",4],["dialogues","r172544","Узнать дорогу в Царство Природы",4],["dialogues","r172550","Что такое Царство Природы?",0],["dialogues","r172551","Что такое Царство Природы?",0],["dialogues","r172559","Сохранение класса",0],["dialogues","r172563","Вернуться на класс",0],["dialogues","r172565","Разузнать о мистиках",0],["dialogues","r172650","Разузнать о воинах",0],["dialogues","r172722","Разузнать о жрецах",0],["dialogues","r172833","Разузнать о разведчиках",0],["dialogues","r172918","Разузнать об инженерах",0],["dialogues","r172927","Разузнать об инженерах",0],["dialogues","r172929","Разузнать об инженерах",0],["dialogues","r172940","Разузнать о храмовниках",0],["dialogues","r173098","Начать обм