[["dialogues","r506942","[Рассказать Мраку о том, что случилось]",0],["dialogues","r506943","Ахо, др-рузья! Р-рад, что вы выбр-рались!",0],["dialogues","r507064","Что это за место?",0],["dialogues","r507065","Что здесь происходит?",0],["dialogues","r507066","Я не знаю, куда мне идти.",0],["dialogues","r507067","Здравствуй, ! О чем тебе рассказать?",0],["dialogues","r507163","Кто ты?",0],["dialogues","r507164","Чем ты тут занимаешься?",0],["dialogues","r507170","Приветс-с-с-ствую тебя, путеш-ш-ше-с-ственник!",0],["dialogues","r507181","Чем ты тут занимаешься?",0],["dialogues","r507182","Кто ты?",0],["dialogues","r507183","Как славно видеть, тебя, о Буревестник, средь празднеств пышных!",0],["dialogues","r507184","Чем ты тут занимаешься?",0],["dialogues","r507185","Кто ты?",0],["dialogues","r507189","Чем ты тут занимаешься?",0],["dialogues","r507190","Кто ты?",0],["dialogues","r507191","Привет-привет!",0],["dialogues","r507194","О, вот это да, кого я вижу!",0],["dialogues","r507195","Чем ты тут занимаешься?",0],["dialogues","r507196","Кто ты?",0],["dialogues","r507197","Эй, эй, только тихо! Раз ты меня узнаешь, то понимаешь, что я тут…",0],["dialogues","r507198","Чем ты тут занимаешься?",0],["dialogues","r507199","Кто ты?",0],["dialogues","r507206","Рад приветствовать здесь, средь нас – веселого народа эльфов!",0],["dialogues","r507209","Чем ты тут занимаешься?",0],["dialogues","r507210","Кто ты?",0],["dialogues","r507212","Здравствуй!",0],["dialogues","r507213","Чем ты тут занимаешься?",0],["dialogues","r507214","Кто ты?",0],["dialogues","r507215","Доброго тебя дня, друг!",0],["dialogues","r507220","Чем ты тут занимаешься?",0],["dialogues","r507221","Кто ты?",0],["dialogues","r507222","Чем ты тут занимаешься?",0],["dialogues","r507223","Кто ты?",0],["dialogues","r507224","Приветствую важного гостя! Может Вам нужен костюм? Буду рад помочь с…",0],["dialogues","r507225","Приветствую! Какими судьбами здесь, на Айрине?",0],["dialogues","r507228","Чем ты тут занимаешься?",0],["dialogues","r507229","Кто ты?",0],["dialogues","r507230","Рад тебя снова видеть спустя столько лет.",0],["dialogues","r507231","Чем ты тут занимаешься?",0],["dialogues","r507232","Кто ты?",0],["dialogues","r507237","Можешь не преклонять колени, сейчас не время для церемоний.",0],["dialogues","r507238","Кто ты?",0],["dialogues","r507239","Чем ты тут занимаешься?",0],["dialogues","r507240","А, это ты.",0],["dialogues","r507241","Чем ты тут занимаешься?",0],["dialogues","r507242","Кто ты?",0],["dialogues","r507245","Чем ты тут занимаешься?",0],["dialogues","r507246","Кто ты?",0],["dialogues","r507247","Ух ты, знакомое лицо! Где я могла тебя видеть? Что-то смутно припоминаю…",0],["dialogues","r507252","Приветствую от всей души!",0],["dialogues","r507253","Кто ты?",0],["dialogues","r507254","Чем ты тут занимаешься?",0],["dialogues","r507255","Чем ты тут занимаешься?",0],["dialogues","r507256","Кто ты?",0],["dialogues","r507257","И тебе привет!",0],["dialogues","r507258","Добро пожаловать на Айрин!",0],["dialogues","r507259","Кто ты?",0],["dialogues","r507260","Чем ты тут занимаешься?",0],["dialogues","r507261","Приветствую! Тут, на Айрине, легко и свежо! Приятное разнообразие…",0],["dialogues","r507268","Чем ты тут занимаешься?",0],["dialogues","r507269","Кто ты?",0],["dialogues","r507275","Чем ты тут занимаешься?",0],["dialogues","r507276","Кто ты?",0]]