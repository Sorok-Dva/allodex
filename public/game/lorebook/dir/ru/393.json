[["dialogues","r503793","[Назвать пароль]",0],["dialogues","r503794","Ах, как же тут хорошо…",0],["dialogues","r503798","[Назвать пароль]",0],["dialogues","r503799","[Назвать пароль]",0],["dialogues","r503800","Привет!",0],["dialogues","r503802","[Назвать пароль]",0],["dialogues","r503803","[Назвать пароль]",0],["dialogues","r503804","Эй! Как дела?",0],["dialogues","r503807","[Назвать пароль]",0],["dialogues","r503810","[Назвать пароль]",0],["dialogues","r503811","Привет-привет!",0],["dialogues","r503814","[Назвать пароль]",0],["dialogues","r503815","[Назвать пароль]",0],["dialogues","r503816","Здравствуй.",0],["dialogues","r503826","[Назвать пароль]",0],["dialogues","r503827","Добрый вечер.",0],["dialogues","r503828","[Назвать пароль]",0],["dialogues","r503829","Хороший денёк…",0],["dialogues","r503834","[Назвать пароль]",0],["dialogues","r503835","Здравствуйте.",0],["dialogues","r503838","[Назвать пароль]",0],["dialogues","r503839","Приветствую.",0],["dialogues","r503842","[Назвать пароль]",0],["dialogues","r503843","Как прекрасен Айрин!",0],["dialogues","r503846","[Назвать пароль]",0],["dialogues","r503847","Как твои дела?",0],["dialogues","r503850","[Назвать пароль]",0],["dialogues","r503851","Приветик.",0],["dialogues","r503854","[Назвать пароль]",0],["dialogues","r503855","Эх…",0],["dialogues","r503874","Нечасто встретишь гибберлингов-музыкантов…",0],["dialogues","r503875","Хей-хей! Приветики!",0],["dialogues","r503880","Ну что, готов зажигать?",0],["dialogues","r503881","Приветствую!",0],["dialogues","r503884","Какими судьбами на Айрине?",0],["dialogues","r503885","Давно не виделись!",0],["dialogues","r503886","Главное – держать ритм и бить в барабан крепко, как жену по заднице!",0],["dialogues","r503889","Я помогаю с подготовкой Бала по просьбе короля.",0],["dialogues","r503890","О, дивная судьба! ! Как рад я видеть знакомое лицо в этих краях! Чья…",0],["dialogues","r503891","Ты прибыл с Аммры?",0],["dialogues","r503892","Приветствую тебя, друг! Рад видеть тебя в этом чудесном месте! Я –…",0],["dialogues","r503895","Хочешь поучаствовать в эльфийском концерте?",0],["dialogues","r503896","Пусть будет день твой добр, друже!",0],["dialogues","r503899","Ты тоже прибыла на Айрин ради концерта?",0],["dialogues","r503900","Ахо, др-руг! Да благословят тебя пр-редки!",0],["dialogues","r503902","Ты тоже решила участвовать в этом мероприятии?",0],["dialogues","r503903","Доброго дня, товарищ!",0],["dialogues","r503921","А ты куда потом отправился?",0],["dialogues","r503922","Уф… уф… Дай отдышаться! Сил нет уже за этими бумажками бегать. Каспар…",0],["dialogues","r504014","Значит теперь ты в ответе за всех вампиров?",0],["dialogues","r504104","Трисс, я думаю, тебе нужно передохнуть. Возвращайся в резиденцию.",0],["dialogues","r504105","Привет-привет!",0],["dialogues","r504171","Росан, мне нужно побыть одному. Жди меня в резиденции.",0],["dialogues","r504187","Так, а что если… Нет, не то…",0],["dialogues","r504241","Акила, я больше не нуждаюсь в твоей компании. Вернись в резиденцию.",0],["dialogues","r504253","Ах… Ну чего тебе?",0],["dialogues","r504355","Грим, я больше не нуждаюсь в твоем сопровождении. Вернись в резиденцию.",0],["dialogues","r504366","Какая идея пришла тебе в голову?",0],["dialogues","r504423","Лея, тебе больше не нужно быть в моей компании. Возвращайся в свой Дом.",0],["dialogues","r504444","Как здесь красиво, да?",0],["dialogues","r504488","Лир, я хочу побыть один. Возвращайся в резиденцию.",0],["dialogues","r504500","Что же ты хочешь мне сказать?",0],["dialogues","r504552","Элия, твоя компания больше не требуется. Вернись в резиденцию.",0],["dialogues","r504559","Я тебя внимательно слушаю.",0]]