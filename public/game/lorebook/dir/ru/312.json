[["dialogues","r186117","Ты чего, боишься?",2],["dialogues","r186118","Ладно, попробуем снова",0],["dialogues","r186119","Давай залезай в скафандр! Быстро!",0],["dialogues","r186120","Стрелка, полезай уже в скафандр!",0],["dialogues","r186121","К полёту готовы! Сказали говорить так.",0],["dialogues","r186130","[Убрать руки и отойти]",0],["dialogues","r186131","А вот смотрите, птичка! [Потянуться к карману]",0],["dialogues","r186132","Это птичка там прыгает! [Вытащить пропуск]",2],["dialogues","r186133","Это ракета приземляется! [Вытащить пропуск]",0],["dialogues","r186134","Кажется, что-то загорелось! [Вытащить пропуск]",0],["dialogues","r186135","Да вот, там, мелькает на стартовой площадке… [Нащупать пропуск]",2],["dialogues","r186136","Это, наверное, птичка светится… [Нащупать пропуск]",0],["dialogues","r186137","Может, взрыв? [Нащупать пропуск]",0],["dialogues","r186138","А что это там такое светится? [Потянуться к карману]",0],["dialogues","r186139","Смотрите мне прямо в глаза! [Потянуться к карману]",0],["dialogues","r186141","Что планируете делать?",2],["dialogues","r186156","Выбрать напротив строки пункт: «Открыть».",2],["dialogues","r186157","Выбрать напротив строки пункт: «Открыть».",0],["dialogues","r186158","Пролистать список дверей",2],["dialogues","r186159","Перед вами панель управления дверьми Космодрома.",0],["dialogues","r186179","Перед вами несколько ящиков",0],["dialogues","r186185","Ты не одинок, друг. Мы здесь, чтобы понять, почему ты прибыл в наш мир.",0],["dialogues","r186211","Главное - чтобы поезда ходили без задержек и опозданий! На нас смотрит…",2],["dialogues","r186219","Нам бы билет на поезд.",2],["dialogues","r186220","«Жену ты можешь не любить, детей не видеть много лет, но чтоб проезд…",2],["dialogues","r186226","Что случилось?",2],["dialogues","r186227","Критической сбой системы, отсутствует управляющий модуль…",2],["dialogues","r186228","На мне лежит ответственность за состояние Сар-Шаззара! И за экономию…",2],["dialogues","r186255","Расскажешь о том, что тут происходит?",2],["dialogues","r186256","Мы определенно не успеваем завершить всё в срок! Уж я-то знаю…",2],["dialogues","r186287","Есть что сообщить интересное?",2],["dialogues","r186288","Вечно какая-то путаница, то куриные яйца пришлют, то всю документацию…",2],["dialogues","r186353","[Дать ему съесть жертву!]",2],["dialogues","r186354","[Прогнать горыныча!]",2],["dialogues","r186355","Ты чего хочешь?",2],["dialogues","r186356","А-ррр! Ам-ам! А-ррр!",2],["dialogues","r186359","Что случилось?",2],["dialogues","r186360","А-а-а-а-а! Спасите! Помогите!",2],["dialogues","r186367","Осмотреть…",2],["dialogues","r186368","Пробирки с неизвестным содержимым",2],["dialogues","r186374","Осмотреть…",2],["dialogues","r186375","Загадочная реторта",2],["dialogues","r186380","Осмотреть…",2],["dialogues","r186381","Странная колба",2],["dialogues","r186389","Читать записи из первого дневника «Г.»",2],["dialogues","r186390","Это записи из первого дневника «Г.»",2],["dialogues","r186394","Читать записи из второго дневника «Г.»",2],["dialogues","r186395","Это записи из второго дневника «Г.»",2],["dialogues","r186398","Читать записи из третьего дневника «Г.»",2],["dialogues","r186399","Это записи из третьего дневника «Г.»",2],["dialogues","r186402","Читать записи из четвёртого дневника «Г.»",2],["dialogues","r186403","Это записи из четвертого дневника «Г.»",2],["dialogues","r186406","Читать записи из пятого дневника «Г.»",2],["dialogues","r186407","Это записи из пятого дневника «Г.»",2],["dialogues","r186410","Читать записи из шестого дневника «Г.»",2],["dialogues","r186411","Это записи из шестого дневника «Г.»",2],["dialogues","r186414","Читать записи из дневника «Ш.»",2],["dialogues","r186415","Это записи из дневника, написанного неким «Ш.»",2],["dialogues","r186420","Я покончу с тобой!",2],["dialogues","r186421","Уж точно мой мир не для вас…",2],["dialogues","r186422","Чего вы добиваетесь?",2],["dialogues","r186423","Ах, ты ж гад инопланетный!",2],["dialogues","r186424","Ах, вот кто тут шумит! Гибриды позволили вам проникнуть сюда, но…",2],["dialogues","r186429","Ты кто такая?",2]]