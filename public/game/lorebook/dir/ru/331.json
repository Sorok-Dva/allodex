[["characters","r155998","Жизнь всегда найдёт выход.",0],["characters","r155933","Всё погибло бы.",0],["characters","r155997","Я отвечу на пятый вопрос!",0],["characters","r155936","Война, Голод, Болезнь, Смерть",0],["characters","r155993","Жизнь, Смерть, Созидание, Разрушение",0],["characters","r155994","Разум, Дух, Тело, Сознание",0],["characters","r155995","Рождение, Умирание, Возникновение, Распад",0],["characters","r155996","Бытие, Небытие, Удача, Судьба",0],["characters","r155992","Смерть – это зло.",0],["characters","r155991","Смерть – обратная сторона Жизни.",0],["characters","r155990","Мы победили смерть, так как у нас есть Дар Тенсеса.",0],["characters","r155989","Нам нужно найти способ окончательно победить смерть.",0],["characters","r155988","Смерть и Жизнь образуют одно целое в круговороте сущего.",0],["characters","r155983","Время – самая разрушительная вещь во вселенной.",0],["characters","r155984","Разрушение – это точно зло.",0],["characters","r155985","Всё идет к своему концу.",0],["characters","r155986","Конец всех миров, который мы обязаны предотвратить.",0],["characters","r155987","Истинная цель Нихаза.",0],["characters","r155978","Созидание способно противостоять бегу времени.",0],["characters","r155979","Нихаз может обернуть время вспять.",0],["characters","r155980","Жизнь сильнее, чем время.",0],["characters","r155981","Порядок может одолеть время.",0],["characters","r155982","Творцы, создавая миры, противостоят разрушительной энтропии времени.",0],["characters","r155937","Это одно и тоже.",0],["characters","r155938","Они противостоят друг другу.",0],["characters","r155975","Одно порождается другим.",0],["characters","r155976","Это сложный вопрос, на который нет однозначного ответа.",0],["characters","r155977","Разница между ними субъективна.",0],["characters","r155974","Я отвечу на шестой вопрос!",0],["characters","r155971","Их множество, и каждый из них служит своему народу.",0],["characters","r155972","Герои – это одиночки в толпе, которая их обожествляет.",0],["characters","r155973","Каждый из нас герой, но по-своему.",0],["characters","r155963","Герои сами возникают под воздействием обстоятельств.",0],["characters","r155966","Герои приходят, когда они нужны.",0],["characters","r155967","Героев создают боги в качестве ответа на молитвы людей.",0],["characters","r155968","Герой появляется из среды народа.",0],["characters","r155969","Герой совершает свои подвиги ради красивой дамы.",0],["characters","r155970","Нет героев, есть простые люди в необычных обстоятельствах.",0],["characters","r155957","Герой должен уничтожать чудовищ!",0],["characters","r155961","Герой должен добывать сокровища!",0],["characters","r155964","Герой должен спасать прекрасных дев!",0],["characters","r155962","Герой должен исполнять желания богов!",0],["characters","r155965","Герой должен стать самым сильным в мире!",0],["characters","r155960","Герой никому ничего не должен, он сам решит, что делать.",0],["characters","r155954","Чудовища сами возникают из пустоты.",0],["characters","r155951","Чудовища – порождение Хаоса, Тьмы и Смерти.",0],["characters","r155958","Чудовища – это суть мира, который не освоен героем.",0],["characters","r155955","Чудовищ создают сами боги, чтобы герои с ними сражались.",0],["characters","r155959","Чудовища – это те, кто бродит на границе цивилизации и дикости.",0],["characters","r155956","Мы сами создаем своих чудовищ.",0],["characters","r155945","Герой ищет сокровища!",0],["characters","r155948","Герой хочет разорвать цепь причин и следствий!",0],["characters","r155949","Герой ищет прекрасную деву!",0],["characters","r155953","Герой хочет свергнуть богов!",0],["characters","r155950","Герой ищет смысл бытия!",0],["characters","r155952","Герой ищет своё бессмертие!",0],["characters","r155942","Да, он отберет его!",0],["characters","r155943","Да, он завоюет его!",0],["characters","r155946","Да, он разгадает, как его получить!",0],["characters","r155944","Да, он покажет, что достоин его!",0],["characters","r155947","Да, он будет молить даровать его!",0],["characters","r155940","Нет, судьба героя – умереть.",0],["characters","r155939","Верни меня обратно к своему воплощению",0],["characters","r514754","Что ты хочешь сказать?",0]]