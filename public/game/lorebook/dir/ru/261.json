[["dialogues","r137747","Спросить мнение Поля",0],["dialogues","r137748","Приветствую, уважаемый. Кажется, я не имею чести быть знаком с вами?",0],["dialogues","r137755","Спросить мнение Андрея",0],["dialogues","r137756","Добрый день, товарищ! Чем обязан?",0],["dialogues","r137948","Забраться на огра",0],["dialogues","r137949","Фёдор?",0],["dialogues","r138034","Продолжить путь",0],["dialogues","r138135","Отправиться в столицу",0],["dialogues","r138136","Рассказать Веронике про архитекторов и нападение на Дайн",0],["dialogues","r138137","Так-так-так... Кто это тут у нас? Ну надо же! Пьеса новая - актёры…",0],["dialogues","r138200","Рассказать учёной про обнаруженный на хуторе материал",0],["dialogues","r138462","Продолжить допрос",0],["dialogues","r138463","Допросить пророка",0],["dialogues","r138464","К оружию, мои ферные фоины! Защититье сфоего Феликого Пророка!…",0],["dialogues","r138471","Сказать, что вы поведёте «Полнолуние»",0],["dialogues","r138472","О, привет! Что, тоже не можешь отвести взгляда от «Полнолуния»?…",0],["dialogues","r138591","Отдать приказ к атаке",0],["dialogues","r138592","Здорово задали этим тварями! Какие приказы будут, командир?",0],["dialogues","r138615","Запугать",0],["dialogues","r138621","Дождаться курьера",0],["dialogues","r138622","Пригрозить торговцу трибуналом",0],["dialogues","r138623","Налетай, торопись, покупай живопись!",0],["dialogues","r138712","Спросить о дальнейших действиях",0],["dialogues","r138719","Рассказать о корабле на верфях",0],["dialogues","r138720","Флот уничтожен, твари повсюду! Нам некуда бежать! Мы обречены...",0],["dialogues","r138750","Согласиться",0],["dialogues","r138751","Спросить, не пора ли отчаливать",0],["dialogues","r138752","Спросить, что делать дальше",0],["dialogues","r138753","Якорь мне в корму! Я ж тебя помню! В Береговом виделись! Ну как…",4],["dialogues","r138778","Осмотреть искажение",0],["dialogues","r138779","Расколоть ядра",0],["dialogues","r138780","Войти в искажение",0],["dialogues","r138781","Пространство вокруг искажения плывёт и колеблется, внутри него…",0],["dialogues","r138795","Напоить матроса грибным отваром",0],["dialogues","r138796","Прочь... Прочь... Я вам не поддамся! Вас нет! Вы не существуете!",0],["dialogues","r138870","Поговорить с Береникой",4],["dialogues","r138871","О, неужто к нам пожаловала гроза архитекторов собственной персоной?…",0],["dialogues","r138890","Выслушать",0],["dialogues","r138891","Здорово! Так это, выходит, тебя вроде как дожидаемся? Ну, слушай…",0],["dialogues","r138901","Расспросить посыльного",0],["dialogues","r138902","Там... Там чудовище! Мы нашли его!",0],["dialogues","r138905","Спросить об убийцах",0],["dialogues","r138906","Ох... Кровью истекаю...",0],["dialogues","r138939","Допросить",0],["dialogues","r138940","Ну, спрашивай, чего надо, да отвали от меня — и так тошно!",0],["dialogues","r138944","Допросить",0],["dialogues","r138945","Ох, ужас-то какой...",0],["dialogues","r138948","Допросить",0],["dialogues","r138949","Всякого я в жизни повидал, но такого - и представить не могу.",0],["dialogues","r138967","Отправиться в путь",0],["dialogues","r138968","Рассказать о грядущем взрыве",0],["dialogues","r138980","Отправиться дальше",0],["dialogues","r138981","Рассказать об архонте",0],["dialogues","r138982","Вперёд! Клянусь, сегодня знамя нашей Победы взовьётся над этой…",0],["dialogues","r139152","Начать сложный бой",0],["dialogues","r139154","Начать обычный бой",0],["dialogues","r139164","Доложить о взятии высоты «Воробей»",0],["dialogues","r139165","Ну что, как обстановка? Можно идти аль погодить чутка?",0],["dialogues","r139451","Согласиться помочь",0],["dialogues","r139452","Спросить, что происходит",0],["dialogues","r139455","Согласиться",0],["dialogues","r139456","Спросить причину остановки",0],["dialogues","r139457","Наконец-то подмога! А мы уж было думали, что на помощь из…",0],["dialogues","r139485","Понимающе кивнуть",0]]