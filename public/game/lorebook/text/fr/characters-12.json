ent"}},"r550015":{"t":[],"s":"Ведьма-пряха","i":[{"t":[["text",0,0]]}],"m":{"era":"recent"}},"r160368":{"t":[],"s":"Князь","i":[{"t":[["text",0,0]]},{"t":[["text",0,0]],"h":["name",0,0]}],"m":{"era":"legacy"}},"r544508":{"t":[],"s":"Извозчик","i":[{"t":[["text",0,0]],"h":["name",0,0]},{"t":[["text",0,0]]}],"m":{"era":"recent"}},"r544688":{"t":[],"s":"Магограмма","m":{"era":"recent"}},"r546449":{"t":[],"s":"Благородный дворянин","m":{"era":"recent"}},"r547731":{"t":[],"s":"Бог-крокодил","i":[{"t":[["text",0,0]]},{"t":[["text","Pourquoi donc devrais-je barboter dans la boue qui recouvre ce vieux caillou moussu ?",0]]},{"t":[["text","C'est une statue très ancienne, encore bien plus vieille que celle du Bienfaiteur. Les Immortels n'aiment pas que nous parlions de cela. De plus, ce n'est pas vraiment d'actualité. C'est pourquoi il n'y a que d'étranges vieillards qui se souviennent de la légende du crocodile, et mon grand-père en fait partie. Puisse l'herbe être douce sous ses pieds. La légende dit à peu près cela. Il y a fort longtemps, à l'époque où les Anciens disparurent, laissant le monde plongé dans l'obscurité, les Tekyans vivaient dans la tourmente et la pauvreté. Au cours d'une année particulièrement mauvaise, la rivière Jumayo s'assécha et la soif vint s'ajouter à l'interminable liste de problèmes des Tekyans. Ils pensèrent alors que leur fin était venue. Mais un dieu crocodile bienveillant apparut. Il frappa le sol avec sa puissante queue, faisant jaillir une source d'eau pure et fraîche. Les Tekyans louèrent leur sauveur et érigèrent cette statue en son honneur. Voilà, c'est à peu près tout...",0]],"h":["name","Se renseigner sur la statue du crocodile",0]}],"m":{"era":"recent"}},"r544459":{"t":[],"m":{"era":"legacy"}},"r542690":{"t":[],"s":"Наездник на гиене","i":[{"t":[["text",0,0]],"h":["name",0,0]},{"t":[["text",0,0]],"h":["name",0,0]},{"t":[["text",0,0]],"h":["name",0,0]}],"m":{"era":"recent"}},"r238405":{"t":[],"s":"Приключенец","m":{"era":"recent"}},"r167865":{"t":[],"s":"Селянин","i":[{"t":[["text",0,0]],"h":["name",0,0]},{"t":[["text",0,0]]}],"m":{"era":"recent"}},"r548684":{"t":[],"s":"Василиск западного аванпоста","m":{"era":"recent"}},"r97826":{"t":[],"s":"Псарь","m":{"era":"recent"}},"r545662":{"t":[],"m":{"era":"recent"}},"r165810":{"t":[],"i":[{"t":[["text",0,0]]},{"t":[["text",0,0]],"h":["name",0,0]},{"t":[["text","Vous n'allez pas le croire, mais il y a quelques mois, il s'est passé quelque chose de très étrange. Le bord de notre île, qui était resté intact pendant des millénaires, a soudainement commencé à fondre, comme de la neige au soleil !\n\nAprès que tout ait commencé à s'effondrer ici, j'ai trouvé cet endroit étrange avec ce morceau de glace inhabituel ! Je voulais l'étudier, mais l'Urun est arrivé en courant et... je me suis cachée dans une congère. Vous avez vu le reste.",0]],"h":["name","Dites-moi ce qui s'est passé ici.",0]}],"l":{"quests":[["quests/r165901","Злая Недоля"]]},"m":{"era":"recent"}},"r547056":{"t":[],"m":{"era":"recent"}},"r543783":{"t":[],"m":{"era":"recent"}},"r547721":{"t":[],"s":"Шаманка кентавров","i":[{"t":[["text",0,0]]}],"m":{"era":"recent"}},"r162078":{"t":[],"i":[{"t":[["text",0,0]],"h":["name",0,0]},{"t":[["text",0,0]]}],"l":{"quests":[["quests/r162277","Сжечь ведьму!"]]},"m":{"era":"recent"}},"r548441":{"t":[],"s":"Красная ведьма","m":{"era":"recent"}},"r546058":{"t":[],"s":"Пушистый хранитель тайн","i":[{"t":[["text",0,0]]}],"m":{"era":"recent"}},"r543785":{"t":[],"m":{"era":"recent"}},"r162860":{"t":[],"i":[{"t":[["text",0,0]],"h":["name",0,0]},{"t":[["text",0,0]]}],"m":{"era":"legacy"}},"r167250":{"t":[],"s":"Капитан авиаков","l":{"quests":[["quests/r167214","Малфас, демон-колдун, и его свита"]]},"m":{"era":"recent"}},"r524051":{"t":[],"s":"Boss d'élite","m":{"era":"recent"}},"r162365":{"t":[],"s":"Полуэльфийка","l":{"quests":[["quests/r161902","Наследие Валиров"]]},"m":{"era":"recent"}},"r166731":{"t":[],"m":{"era":"recent"}},"r550700":{"t":[],"s":"Свободный Торго