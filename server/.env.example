# Copier en server/.env (non versionné).
# Base MySQL 5.7+ / MariaDB 10.3+ ; les tables sont créées au démarrage (migrations drizzle/).
DATABASE_URL=mysql://allodex:motdepasse@127.0.0.1:3306/allodex
# Mot de passe du tableau de bord /stats. Vide : l'administration est désactivée.
ADMIN_PASSWORD=
# Secret de signature du cookie d'administration. Vide : généré et conservé dans la base.
SESSION_SECRET=
# PORT=8787
# HOST=127.0.0.1
# SITE_URL=https://allodex.eu
# DIST_DIR=../dist
# Sert aussi les fichiers de dist/ (sans nginx devant, ou pour essayer le build en local).
# SERVE_STATIC=1
