# À fusionner dans le vhost existant du site (celui qui sert dist/). Ne pas copier ce fichier
# tel quel dans sites-enabled/ : tout ce qui s'y trouve est chargé.

upstream allodex_api {
    server 127.0.0.1:8787;
    keepalive 16;
}

server {
    # … listen, server_name, certificats, root …/dist, et les blocs existants
    # (cache d'un an sur /assets/, de trente jours sur /game/ et /fonts/) …

    gzip on;
    gzip_types application/xml text/plain application/json text/css application/javascript;

    # Les en-têtes d'origine sont RÉÉCRITS : le serveur ne croit que ceux-là.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Mesure d'audience et tableau de bord. `proxy_buffering off` : flux du direct (SSE).
    location /api/ {
        proxy_pass http://allodex_api;
        proxy_buffering off;
        proxy_read_timeout 1h;
        client_max_body_size 16k;
    }

    # Plan du site, robots.txt : générés par le serveur à partir du Lorebook.
    location = /robots.txt  { proxy_pass http://allodex_api; }
    location = /sitemap.xml { proxy_pass http://allodex_api; }
    location /sitemaps/     { proxy_pass http://allodex_api; }

    # Images Open Graph.
    location /og/ {
        expires 7d;
        add_header Cache-Control "public";
    }

    # Pages : un fichier de dist/ s'il existe, sinon index.html complété par le serveur (titre,
    # description, Open Graph, hreflang, 404 des chemins inconnus). Serveur arrêté : index.html
    # tel quel, le site reste en ligne avec les balises de l'accueil.
    # (remplace l'ancien `location / { try_files $uri $uri/ /index.html; }`)
    location = / {
        proxy_pass http://allodex_api;
        proxy_intercept_errors on;
        error_page 502 503 504 = @static;
    }
    location / {
        try_files $uri @page;
    }
    location @page {
        proxy_pass http://allodex_api;
        proxy_intercept_errors on;
        error_page 502 503 504 = @static;
    }
    location @static {
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }
}

# Domaine principal : allodex.eu. Les autres noms redirigent (301), requête comprise, pour
# qu'une seule adresse par page soit indexée.
server {
    listen 443 ssl;
    http2 on;
    server_name allodex.online allodex.allods-developers.eu;
    # … certificats (les mêmes que le vhost principal s'ils couvrent ces noms) …
    return 301 https://allodex.eu$request_uri;
}
# Redirection HTTP → HTTPS, si le vhost actuel (certbot) ne la fait pas déjà pour ces noms.
server {
    listen 80;
    server_name allodex.eu allodex.online allodex.allods-developers.eu;
    return 301 https://allodex.eu$request_uri;
}
